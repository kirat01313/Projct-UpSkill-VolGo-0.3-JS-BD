nt="1" source="T_Concelho_r0" target="T_Posto_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E14" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#6C8EBF;" edge="1" parent="1" source="T_Posto_r0" target="T_PostoConector_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E15" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#6C8EBF;" edge="1" parent="1" source="T_TipoConector_r0" target="T_PostoConector_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E16" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;fontColor=#9673A6;" edge="1" parent="1" source="T_Cliente_r0" target="T_Reserva_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E17" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#6C8EBF;" edge="1" parent="1" source="T_Posto_r0" target="T_Reserva_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E18" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#D6B656;fontColor=#D6B656;" edge="1" parent="1" source="T_Tarifario_r0" target="T_TarifarioPreco_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="E19" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;fontColor=#9673A6;" edge="1" parent="1" source="T_Cliente_r0" target="T_Veiculo_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legenda" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• &lt;b&gt;PK&lt;/b&gt; negrito+sublinhado = chave primária&lt;br&gt;• &lt;i&gt;FK&lt;/i&gt; itálico = chave estrangeira&lt;br&gt;• &lt;b&gt;AK&lt;/b&gt; = chave alternativa (UNIQUE)&lt;br&gt;• O pé de galinha fica sempre do lado &lt;b&gt;N&lt;/b&gt;, onde vive a FK&lt;br&gt;• A cor da linha indica a área de origem&lt;br&gt;• A linha a cheio dentro da tabela separa as chaves dos dados" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;fontColor=#1A1A1A;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1100" y="1330" width="480" height="160" as="geometry"/></mxCell><mxCell id="nota" value="&lt;b&gt;Restrições que o diagrama não consegue mostrar&lt;/b&gt;&lt;br&gt;• &lt;b&gt;UNIQUE filtrado&lt;/b&gt; Carregamento(IDReserva) WHERE NOT NULL — uma reserva concretiza-se no máximo uma vez&lt;br&gt;• &lt;b&gt;UNIQUE filtrado&lt;/b&gt; TarifarioPreco(IDTarifario) WHERE DataFim IS NULL — um só preço em vigor por tarifário&lt;br&gt;• &lt;b&gt;CHECK&lt;/b&gt; de estados fechados em Reserva, Carregamento, Ocorrencia, Fatura e Alerta&lt;br&gt;• &lt;b&gt;CHECK&lt;/b&gt; Cliente: DataNascimento obrigatória nos particulares, proibida nas empresas&lt;br&gt;• &lt;b&gt;CHECK&lt;/b&gt; Posto: Ativo e DataDesativacao não se podem contradizer&lt;br&gt;• &lt;b&gt;CHECK&lt;/b&gt; Carregamento: Estado 'Faturado' se e só se tiver fatura&lt;br&gt;&lt;br&gt;&lt;b&gt;Decisões de modelação&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Tarifario.PrecoKwhAtual&lt;/b&gt; é uma cópia do preço em vigor, para simplificar consultas. A fonte da verdade é a TarifarioPreco; o trigger TR_TarifarioPreco_SincronizaAtual mantém as duas iguais.&lt;br&gt;• &lt;b&gt;Carregamento aponta para PostoConector&lt;/b&gt; (a tomada) e não para o Posto: a tomada já identifica o posto, e repeti-lo seria redundante.&lt;br&gt;• &lt;b&gt;Remoção lógica&lt;/b&gt; em Posto, Cliente e Tarifario: nada se apaga (regra 3.8).&lt;br&gt;• &lt;b&gt;Sem DataResolucao&lt;/b&gt; na Ocorrencia: deriva-se do histórico.&lt;br&gt;&lt;br&gt;&lt;b&gt;Limitações assumidas&lt;/b&gt;&lt;br&gt;• Sem IDPosto no Carregamento, não se garante por chave que o carregamento acontece no posto reservado.&lt;br&gt;• Sobreposição entre vigências de preço já fechadas exigiria trigger." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF8E7;strokeColor=#D6B656;fontSize=11;fontColor=#1A1A1A;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1100" y="1520" width="480" height="480" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>